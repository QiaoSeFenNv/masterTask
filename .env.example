# 服务端密钥与应用配置
# ⚠️ 本文件不得提交到 git（已在 .gitignore 中排除）
# 复制为 .env 后填写真实值

# ---------- 微信小程序 ----------
WX_APPID=wx9fd6453e42bc9d4e
# ⚠️ 只填在服务器上，不要写进代码、不要发到聊天里
WX_APPSECRET=

# ---------- 鉴权 ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# ---------- 服务 ----------
PORT=3000
NODE_ENV=production
# 逻辑时区（日界：0 点切割，0-6 点算前一天）
APP_TZ=Asia/Shanghai
DAY_ROLLOVER_HOUR=6

# ---------- 测试开关（上线前确认关掉） ----------
# 是否放出「重新抽卡」按钮。开发环境默认开，生产环境（NODE_ENV=production）强制关。
# 一天一次的仪式、连续天数、图鉴收藏都建立在「当天不可改」上，正式版不能开。
ALLOW_REDRAW=1

# ---------- 存储 ----------
DB_PATH=./data/roles.db
# 角色插画对外地址前缀（放到服务器静态目录后，填 https://api.你的域名.com/static）
STATIC_BASE_URL=

# ---------- 订阅消息 ----------
# 小程序后台 → 订阅消息 → 选用模板后得到的模板 ID
WX_SUBSCRIBE_TEMPLATE_ID=