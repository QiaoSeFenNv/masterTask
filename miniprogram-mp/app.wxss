/* 现代深色底 + 衬线中文标题的排版风格：暗色卡片、暖金点缀、大量留白 */

page {
  background: #0e0b14;
  color: #efe9df;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text {
  box-sizing: border-box;
}

.page-wrap {
  min-height: 100vh;
  padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* ---------- 通用文字 ---------- */
.serif {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
}

.muted {
  color: #8a8398;
}

.tiny {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ---------- 卡片 ---------- */
.card-sheen {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

.card-sheen::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0) 42%);
  pointer-events: none;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  border: none;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #e8dcc8, #cbb89a);
  color: #1a1420;
  font-weight: 600;
}

.btn-ghost {
  background: transparent;
  color: #cbc3d4;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.btn:active {
  transform: scale(0.975);
  opacity: 0.9;
}

/* ---------- 分割 ---------- */
.hairline {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

/* ---------- 骨架屏 ---------- */
.skeleton {
  background: linear-gradient(90deg, #1a1522 25%, #241d2e 37%, #1a1522 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 16rpx;
}

@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}