.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(14, 11, 20, 0.94);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: transparent;
  transition: background 0.2s ease, transform 0.2s ease;
}

.tab-item.is-active .tab-dot {
  background: #e8dcc8;
  transform: scale(1.4);
}

.tab-label {
  font-size: 24rpx;
  color: #6b6478;
  letter-spacing: 2rpx;
  transition: color 0.2s ease;
}

.tab-item.is-active .tab-label {
  color: #efe9df;
}