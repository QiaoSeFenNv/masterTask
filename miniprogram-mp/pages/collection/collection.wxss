.collection {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 48rpx;
}

.title {
  font-size: 52rpx;
  letter-spacing: 4rpx;
}

/* ---------- 总览 ---------- */
.overview {
  display: flex;
  padding: 32rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 44rpx;
}

.oitem {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.onum {
  font-size: 44rpx;
  color: #e8dcc8;
}

.olabel {
  font-size: 22rpx;
  color: #6b6478;
}

/* ---------- 进度 ---------- */
.progress-block {
  margin-bottom: 40rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.progress-track {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #a99cc0, #e8dcc8);
  border-radius: 3rpx;
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------- 卡片网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-cell {
  width: 31.5%;
  height: 296rpx;               /* 3 : 4.2 比例；固定高度比 aspect-ratio 兼容性更稳 */
  border-radius: 22rpx;
  margin-bottom: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.card-cell.is-owned {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14), 0 10rpx 30rpx rgba(0, 0, 0, 0.35);
}

.card-cell.is-locked {
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx dashed rgba(255, 255, 255, 0.08);
}

.card-cell:active {
  transform: scale(0.96);
}

.card-emoji {
  font-size: 60rpx;
  line-height: 1;
}

.card-name {
  font-size: 28rpx;
  color: #fff;
  margin-top: 18rpx;
  letter-spacing: 2rpx;
}

.card-times {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.lock-mark {
  font-size: 52rpx;
  color: #3a3348;
  line-height: 1;
}

.lock-hint {
  font-size: 20rpx;
  color: #3a3348;
  margin-top: 14rpx;
}

.cell-skel {
  width: 31.5%;
  height: 296rpx;
  margin-bottom: 22rpx;
}

/* ---------- 详情 ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  width: 600rpx;
  border-radius: 32rpx;
  padding: 80rpx 56rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.6);
  animation: sheetIn 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes sheetIn {
  from { opacity: 0; transform: scale(0.94) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.sheet-emoji {
  font-size: 110rpx;
  line-height: 1;
}

.sheet-name {
  font-size: 60rpx;
  color: #fff;
  letter-spacing: 8rpx;
  margin-top: 24rpx;
}

.sheet-tagline {
  font-size: 26rpx;
  letter-spacing: 3rpx;
  margin-top: 12rpx;
}

.sheet-line {
  width: 60rpx;
  height: 2rpx;
  margin: 32rpx 0;
  opacity: 0.7;
}

.sheet-intro {
  font-size: 28rpx;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.88);
  text-align: center;
}

.sheet-foot {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 40rpx;
}