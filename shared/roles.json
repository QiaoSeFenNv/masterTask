        { "id": "wd-6", "text": "找一样你所在城市／街区独有的东西，记下它的名字", "tag": "发现" },
        { "id": "wd-7", "text": "今天吃饭，选一家你从没去过的店", "tag": "尝试" },
        { "id": "wd-8", "text": "在一个陌生地方坐十分钟，什么都不做，只是看", "tag": "停留" }
      ]
    },
