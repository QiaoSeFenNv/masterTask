      "accent": "#e9c46a",
      "tasks": [
        { "id": "dt-1", "text": "找一个你每天路过、但从没细看过的地方，写下三个你第一次注意到的细节", "tag": "观察" },
        { "id": "dt-2", "text": "听一段身边的对话（不参与），推测说话的两个人的关系", "tag": "观察" },
        { "id": "dt-3", "text": "找出今天最反常的一件事，问自己：它为什么会这样", "tag": "追问" },
        { "id": "dt-4", "text": "翻一条三个月前的聊天记录，找一个当时没在意的信息", "tag": "回溯" },
        { "id": "dt-5", "text": "从一个人的桌面／房间布局，推断他最近在忙什么", "tag": "推理" },
